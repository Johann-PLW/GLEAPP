<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for the portable version of GLEAPP.
  SignPath uses its own copy, so edit both in case of changes.

  release.yml uploads the single-file Windows executable as one GitHub artifact, which
  GitHub zips, with GLEAPP.exe at its root. The third-party libraries packed inside it
  (Python, OpenCV, pythonnet, Microsoft's WebView2 assemblies) are not signed on their
  own: our signature would vouch for code we did not build.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="GLEAPP.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
